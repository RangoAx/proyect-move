[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
script/source = "extends Node3D

func _ready() -> void:
	print('Testing AnimationPlayer in headless mode...')
	var glb = load('res://assets/models/Animation personaje.glb').instantiate()
	add_child(glb)
	var anim = glb.find_child('AnimationPlayer', true, false) as AnimationPlayer
	print('Found anim player: ', anim != null)
	anim.play('Ataque1')
	print('Playing Ataque1, is_playing: ', anim.is_playing())
	var finished = false
	anim.animation_finished.connect(func(n): print('Animation finished signal received: ', n); finished = true)
	for i in range(30):
		await get_tree().physics_frame
	print('After 30 frames, finished = ', finished, ' current_pos = ', anim.current_animation_position)
	get_tree().quit(0)
"

[node name="TestAnimHeadless" type="Node3D"]
script = SubResource("1")


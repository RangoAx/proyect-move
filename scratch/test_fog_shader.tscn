[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
script/source = "extends Node3D

func _ready() -> void:
	print('--- Testing FogVolume with shader_type fog ---')
	var fv = FogVolume.new()
	fv.shape = RenderingServer.FOG_VOLUME_SHAPE_BOX
	fv.size = Vector3(40, 10, 40)
	
	var shader = Shader.new()
	shader.code = '''
shader_type fog;

uniform float radius = 17.5;
uniform float thickness = 3.0;
uniform float density = 1.5;

void fog() {
    float dist = length(OBJECT_POSITION.xz);
    float ring_dist = abs(dist - radius);
    if (ring_dist < thickness) {
        float falloff = 1.0 - (ring_dist / thickness);
        DENSITY = density * falloff;
        ALBEDO = vec3(0.6, 0.65, 0.7);
    } else {
        DENSITY = 0.0;
    }
}
'''
	var mat = ShaderMaterial.new()
	mat.shader = shader
	fv.material = mat
	add_child(fv)
	print('FogVolume with custom shader created successfully!')
	get_tree().quit(0)
"

[node name="TestFogShader" type="Node3D"]
script = SubResource("1")


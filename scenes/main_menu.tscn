[node name="TitleLore" type="Label" parent="UI/MenuContainer/LoreScreen/LoreCenter/LorePanel/Margin/VBox" unique_id=1010101013]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)

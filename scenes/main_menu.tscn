text = "DIARIO DE ANTONIO"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="UI/MenuContainer/LoreScreen/LoreCenter/LorePanel/Margin/VBox" unique_id=1010101014]
layout_mode = 2

[node name="TextLore" type="Label" parent="UI/MenuContainer/LoreScreen/LoreCenter/LorePanel/Margin/VBox" unique_id=1112398450]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.9, 0.88, 1)
theme_override_constants/line_spacing = 6
theme_override_font_sizes/font_size = 14
text = "Me llamo Antonio. Soy detective privado.

Acepté este caso porque nadie más quería meter las narices acá: tres personas desaparecieron en este pueblo en menos de un mes, sin dejar una sola pista.

No alcancé a llegar. La niebla en la ruta era tan espesa que no se veía a dos metros. De la nada, algo impactó contra el auto y me tiró de lleno al barranco. El coche dio varias vueltas y terminó prendiéndose fuego contra las rocas.

Mi revólver quedó aplastado entre los fierros calientes del motor, totalmente destruido. Lo único que alcancé a manotear del cinturón antes de que todo explotara fue mi cuchillo militar.

Sin señal, incomunicado y varado en este bosque, solo me queda una opción: entrar al pueblo a pie, averiguar qué demonios pasó acá y salir con vida."
autowrap_mode = 2

[node name="Spacer" type="Control" parent="UI/MenuContainer/LoreScreen/LoreCenter/LorePanel/Margin/VBox" unique_id=1010101015]

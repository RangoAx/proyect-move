[node name="Rama" parent="MainLayout/RamaContainer" unique_id=391351798 instance=ExtResource("2_branch")]
layout_mode = 2
ability_string = "knife_level"
main_icon = ExtResource("3_leaf")
main_explanation = "Cuchillo: Arma básica cuerpo a cuerpo. Ejecuta combos de 3 golpes infligiendo 20 de daño base."
ability_1_icon = ExtResource("4_behavior")
ability_1_explanation = "Nivel 2 — Estocada (Coste: 75 Frags):\nMantén Click Derecho (Aim) para cargar una estocada de 50 de daño directo con gran empuje. Si el ataque no conecta, quedas brevemente vulnerable."
ability_2_icon = ExtResource("5_selector")
ability_2_explanation = "Nivel 3 — Filo Mejorado (Coste: 150 Frags):\nIncremento permanente del daño del combo ligero de 20 a 25 puntos de vida por impacto."

[node name="Rama2" parent="MainLayout/RamaContainer" unique_id=1463404708 instance=ExtResource("2_branch")]
layout_mode = 2
ability_string = "axe_level"
main_icon = ExtResource("6_sequence")
main_explanation = "Hacha Arrojadiza: Proyectil a distancia con mira telescópica (Click Derecho para apuntar). Daño: 25."
ability_1_icon = ExtResource("4_behavior")
ability_1_explanation = "Nivel 2 — Recarga Rápida (Coste: 75 Frags):\nMejora la cadencia de uso. Reduce el tiempo de recarga del hacha de 6 a 3 segundos."
ability_2_icon = ExtResource("5_selector")
ability_2_explanation = "Nivel 3 — Arsenal Ampliado (Coste: 150 Frags):\nExpansión de inventario. Aumenta la capacidad máxima de reserva a 3 hachas simultáneas."

[node name="Rama3" parent="MainLayout/RamaContainer" unique_id=1245946477 instance=ExtResource("2_branch")]
layout_mode = 2
ability_string = "player_level"
main_icon = ExtResource("7_player")
main_explanation = "Vitalidad del Detective: Vitalidad base inicial de 100 unidades de salud."
ability_1_icon = ExtResource("7_player")
ability_1_explanation = "Nivel 2 — Fortalecimiento (Coste: 75 Frags):\nExpande la reserva de salud máxima del jugador de 100 a 150 puntos de vida."
ability_2_icon = ExtResource("7_player")
ability_2_explanation = "Nivel 3 — Resistencia Máxima (Coste: 150 Frags):\nIncremento final de vitalidad. Aumenta la salud máxima del jugador de 150 a 200 puntos de vida."

